{
  "name": "woven",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Woven turns one request in ChatGPT or Codex into a complete compatible cart and one exact confirmation.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server.ts",
    "build": "vite build && vite build --mode widget && tsc --noEmit",
    "frame:render": "node scripts/render-frame.mjs",
    "video:studio": "remotion studio video/index.tsx",
    "video:render": "remotion render video/index.tsx WovenJudgeVideo output/Woven-Judge-Video.mp4 --codec=h264 --crf=18",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/server.ts --stdio",
    "eval:agent": "tsx scripts/eval-open-world.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.536.0",
    "openai": "^7.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media": "4.0.518",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "remotion": "4.0.518",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
