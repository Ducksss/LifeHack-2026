{
  "name": "woven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woven turns one request in ChatGPT or Codex into a complete compatible cart and one exact confirmation.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server.ts",
    "build": "vite build && tsc --noEmit",
    "start": "tsx src/server.ts",
    "mcp": "tsx src/server.ts --stdio",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^5.1.0",
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.5.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.1"
  }
}
